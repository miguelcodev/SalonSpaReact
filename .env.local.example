# Supabase Configuration
# Copy this file to .env.local and fill in your Supabase project credentials
# Never commit .env.local to version control

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key — NEVER expose in client-side code
# Used server-side for admin operations: the future página pública de
# reservas, and the WhatsApp cron (app/api/cron/whatsapp), which runs with
# no authenticated user and must bypass RLS deliberately.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# WhatsApp messaging (lib/whatsapp/)
# "simulated" (default) logs messages to the console and always succeeds —
# lets the queue/cron/history pipeline run without real WhatsApp Business
# API credentials. Switch to a real provider once you have one by
# implementing WhatsappSender against its API (lib/whatsapp/sender.ts).
WHATSAPP_PROVIDER=simulated

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET`
# on scheduled invocations (see vercel.json) — protects the cron endpoint
# from being triggered by anyone who finds the URL. Generate any random
# string for local dev; Vercel sets this automatically in production once
# the env var exists on the project.
CRON_SECRET=your-random-secret-here
