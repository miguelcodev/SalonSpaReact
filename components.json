{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "default",
  "rsc": true,
  "tsx": true,
  "aliasConfig": {
    "baseUrl": ".",
    "paths": {
      "@/*": "./*"
    }
  },
  "tailwind": {
    "config": "tailwind.config.ts",
    "css": "app/globals.css",
    "baseColor": "slate",
    "cssVariables": true
  },
  "resolvedPaths": {
    "ui": "components/ui",
    "utils": "lib/utils"
  }
}
